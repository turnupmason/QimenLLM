    {
      "key": "business_method_01",
      "title": "求财专题：交易求财",
      "category": "role",
      "line_start": 21,
      "line_end": 27,
      "attribution": "原书第一节",
      "summary": "该专题方法与总论共同构成有来源的条件参考；不用作自动绑定、现实经营保证或通用预测",
      "concepts": [
        "交易求财",
