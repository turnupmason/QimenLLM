        "rows": [
          {
            "key": "business-section03-line35",
            "source_lines": [
              35,
              35
            ],
            "source_quote": "（3）买货求财",
            "applicability_status": "reference_only",
            "automatic_role_binding": false,
            "automatic_prediction": false
          },
          {
            "key": "business-section03-line37",
            "source_lines": [
              37,
              37
            ],
            "source_quote": "日干为买主，时干为货物。",
            "applicability_status": "reference_only",
            "automatic_role_binding": false,
            "automatic_prediction": false
          },
          {
            "key": "business-section03-line39",
            "source_lines": [
              39,
              39
            ],
            "source_quote": "时干宫旺相得吉门吉格又上乘吉神者，为货的质量好；休囚不得奇门吉格吉神者，质量次；如果休囚，又临凶门凶格，上乘玄武者，必是假冒伪劣产品或腐烂变质货物。",
            "applicability_status": "reference_only",
            "automatic_role_binding": false,
            "automatic_prediction": false
          },
          {
            "key": "business-section03-line41",
            "source_lines": [
              41,
              41
            ],
            "source_quote": "时干生日干，好货孬货终有利。",
            "applicability_status": "reference_only",
            "automatic_role_binding": false,
            "automatic_prediction": false
          },
          {
            "key": "business-section03-line43",
            "source_lines": [
              43,
              43
            ],
            "source_quote": "时干克日干，或空亡、墓绝，则无利。",
            "applicability_status": "reference_only",
            "automatic_role_binding": false,
            "automatic_prediction": false
          },
          {
            "key": "business-section03-line45",
            "source_lines": [
              45,
              45
            ],
            "source_quote": "日干生时干，为主动去买；日干克时干，也能买成。",
            "applicability_status": "reference_only",
            "automatic_role_binding": false,
            "automatic_prediction": false
          }
        ]
      }
    },
    {
